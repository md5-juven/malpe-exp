# Local development - copy to .env (gitignored)
# cp .env.example .env

# Google Apps Script web app URL (Deploy > Web app > Anyone)
VITE_GOOGLE_SCRIPT_URL=

# Optional: GitHub Pages base path for local preview of Pages builds
# Leave as / for local, CI sets /<repo-name>/ automatically
VITE_BASE_PATH=/

# Optional: comma-separated names who can delete expenses (empty = everyone)
VITE_ADMIN_USERS=
